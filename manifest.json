{
  "id": "/meow-code-app/",
  "name": "Meow Code App",
  "short_name": "MeowCode",
  "description": "Editor HTML visual con vista previa en vivo, temas neón y exportación a PDF",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f0a1a",
  "theme_color": "#0f0a1a",
  "categories": ["developer", "productivity", "utilities", "education"],

  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],

  "screenshots": [
    {
      "src": "./screenshot-mobile-editor.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Editor de código con resaltado de sintaxis y temas neón"
    },
    {
      "src": "./screenshot-mobile-preview.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vista previa en vivo con edición visual directa"
    },
    {
      "src": "./screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Modo escritorio con editor y vista previa lado a lado"
    },
    {
      "src": "./screenshot-desktop-terminal.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Skin Terminal GUI con 6 paletas retro CRT",
      "platform": "windows"
    }
  ],

  "shortcuts": [
    {
      "name": "Editor",
      "short_name": "Editor",
      "description": "Abrir editor de código",
      "url": "./?tab=editor",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vista Visual",
      "short_name": "Preview",
      "description": "Abrir vista previa",
      "url": "./?tab=preview",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ],

  "share_target": {
    "action": "./?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
